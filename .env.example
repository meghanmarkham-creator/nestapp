# ---------------------------------------------------------------------------
# The Nest — environment configuration
# Copy to `.env.local` and fill in. NEVER commit real credentials.
# ---------------------------------------------------------------------------

# --- MOM data source (Snowflake) -------------------------------------------
# Real MOM roleplay/production scores come from the Snowflake view:
#   CUSTOMERCARE.MOM_STANDARD.VW_CX_NEST_SIMULATION_INSIGHTS
# When these are set, the server-side data source queries Snowflake live.
# When unset, the app falls back to deterministic mock data (see lib/momSource.ts),
# so the demo runs with no backend.
NEST_DATA_SOURCE=mock            # "mock" | "snowflake"

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=CUSTOMERCARE
SNOWFLAKE_SCHEMA=MOM_STANDARD
SNOWFLAKE_MOM_VIEW=VW_CX_NEST_SIMULATION_INSIGHTS

# --- Deferred integrations (LATER — see README "What's in this build vs. later")
# Workday org query (advocate pool), Streamlit coaching-plan app, email delivery,
# and auth/authorization are intentionally NOT wired in this first build.
# TODO: WORKDAY_* , COACHING_APP_URL , SMTP_* , AUTH_* when those land.
