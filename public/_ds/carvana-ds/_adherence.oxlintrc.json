{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "ui_kits/carvana-web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Brandon for Carvana))/i]",
        "message": "Font not provided by the design system. Available: Inter, Brandon for Carvana."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|align|inline|icon|open|onDismiss|className|children|key|ref|className|style|children)$/]",
        "message": "<Banner> doesn't accept that prop. Declared props: type, align, inline, icon, open, onDismiss, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<Banner> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|utility|width|isLoading|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, utility, width, isLoading."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:testId|value|name|label|checked|indeterminate|disabled|className|variant|size|onBlur|onChange|onFocus|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: testId, value, name, label, checked, indeterminate, disabled, className, variant, size, onBlur, onChange, onFocus."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|inverse)$/]",
        "message": "<Checkbox> variant must be one of 'primary' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|small)$/]",
        "message": "<Checkbox> size must be one of 'default' | 'small'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:shape|size|selected|disabled|icon|iconPosition|testId|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: shape, size, selected, disabled, icon, iconPosition, testId."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:rectangle|pill)$/]",
        "message": "<Chip> shape must be one of 'rectangle' | 'pill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|large)$/]",
        "message": "<Chip> size must be one of 'default' | 'large'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='iconPosition'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<Chip> iconPosition must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FAQ'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|bodyText|ctaLabel|onCta|children|key|ref|className|style|children)$/]",
        "message": "<FAQ> doesn't accept that prop. Declared props: title, bodyText, ctaLabel, onCta, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='FAQItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:q|defaultOpen|children|key|ref|className|style|children)$/]",
        "message": "<FAQItem> doesn't accept that prop. Declared props: q, defaultOpen, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute > JSXIdentifier[name!=/^(?:onShop|key|ref|className|style|children)$/]",
        "message": "<Hero> doesn't accept that prop. Declared props: onShop."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:s|filled|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: s, filled."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:priority|outlined|CustomIcon|className|children|key|ref|className|style|children)$/]",
        "message": "<IconBadge> doesn't accept that prop. Declared props: priority, outlined, CustomIcon, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='IndicatorBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|priority|customBackground|className|children|key|ref|className|style|children)$/]",
        "message": "<IndicatorBadge> doesn't accept that prop. Declared props: size, priority, customBackground, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='IndicatorBadge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|sm)$/]",
        "message": "<IndicatorBadge> size must be one of 'lg' | 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LabelBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:priority|outline|customIndicatorColor|className|children|key|ref|className|style|children)$/]",
        "message": "<LabelBadge> doesn't accept that prop. Declared props: priority, outline, customIndicatorColor, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:white|height|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: white, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='Review'] > JSXAttribute > JSXIdentifier[name!=/^(?:rating|quote|initials|name|city|key|ref|className|style|children)$/]",
        "message": "<Review> doesn't accept that prop. Declared props: rating, quote, initials, name, city."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|hasError|error|touched|disabled|className|id|onChange|onFocus|onBlur|children|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, value, hasError, error, touched, disabled, className, id, onChange, onFocus, onBlur, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|disabled|children|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:current|onTab|signedIn|onSignIn|banner|key|ref|className|style|children)$/]",
        "message": "<SiteNav> doesn't accept that prop. Declared props: current, onTab, signedIn, onSignIn, banner."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stars'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|size|key|ref|className|style|children)$/]",
        "message": "<Stars> doesn't accept that prop. Declared props: n, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:priority|variant|Icon|iconLeft|iconRight|customBgColor|customBorderColor|customFontColor|className|children|key|ref|className|style|children)$/]",
        "message": "<TextBadge> doesn't accept that prop. Declared props: priority, variant, Icon, iconLeft, iconRight, customBgColor, customBorderColor, customFontColor, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextBadge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:strong|subtle|outline)$/]",
        "message": "<TextBadge> variant must be one of 'strong' | 'subtle' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|value|type|disabled|error|hasError|loading|touched|maxLength|minLength|onChange|onBlur|onFocus|onClear|customIcon|onCustomIconClick|testId|key|ref|className|style|children)$/]",
        "message": "<TextInput> doesn't accept that prop. Declared props: id, label, value, type, disabled, error, hasError, loading, touched, maxLength, minLength, onChange, onBlur, onFocus, onClear, customIcon, onCustomIconClick, testId."
      },
      {
        "selector": "JSXOpeningElement[name.name='Vehicle'] > JSXAttribute > JSXIdentifier[name!=/^(?:year|make|model|trim|miles|price|monthly|delivery|badge|key|ref|className|style|children)$/]",
        "message": "<Vehicle> doesn't accept that prop. Declared props: year, make, model, trim, miles, price, monthly, delivery, badge."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
